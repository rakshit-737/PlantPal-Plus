# Origin the Vite dev server proxies /api requests to.
# Point this at your running @plantpal/api instance.
VITE_API_TARGET=http://localhost:4000

# Static hosts with no /api rewrites (e.g. GitHub Pages): API origin the client calls directly.
VITE_API_URL=

# Subpath the site is served under (GitHub Pages uses /<repo>/); "/" for domain-root hosts.
VITE_BASE=/
