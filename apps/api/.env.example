# PlantPal+ API — environment template.
# Copy to .env and fill in. NFR-SEC-09: never commit a real secret.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (Neon or Supabase). Include ?sslmode=require for hosted providers.
DATABASE_URL=postgresql://user:password@localhost:5432/plantpal

# Access-token signing secret. Minimum 32 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters

# CORS allow-list, comma-separated. Never "*" in production (NFR-SEC-06).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
