# PlantPal+ API — environment template.
# Copy to .env and fill in. NFR-SEC-09: never commit a real secret.

NODE_ENV=development
# 4000 matches the web dev server proxy (apps/web/vite.config.ts).
PORT=4000
LOG_LEVEL=info

# PostgreSQL (Supabase). Use the SESSION POOLER string from Dashboard -> Connect.
# ?sslmode=require is mandatory for hosted providers.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Access-token signing secret. Minimum 32 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-32-chars-minimum........

# CORS allow-list, comma-separated. Never "*" in production (NFR-SEC-06).
CORS_ORIGINS=http://localhost:5173
