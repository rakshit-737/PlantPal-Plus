# Normalise line endings so a Windows, macOS and Linux checkout of this monorepo
# produce identical blobs. Without this, a file touched on Windows shows as
# entirely rewritten in a diff, which buries real changes in review.
* text=auto eol=lf

# Windows-only tooling that genuinely needs CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never munge these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jks binary
*.keystore binary

# Generated lockfiles: keep them in the repo, but collapse them in diffs and
# exclude them from language statistics so the repo is not reported as JSON.
package-lock.json -diff linguist-generated=true

# Documentation drives the language stats for this project; that is accurate,
# but mark the requirements package as documentation rather than source.
docs/** linguist-documentation=true
