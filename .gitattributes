# Normalise line endings so a Windows, macOS and Linux checkout of this monorepo
# produce identical blobs. Without this, a file touched on Windows shows as
# entirely rewritten in a diff, which buries real changes in review.
* text=auto eol=lf

# Windows-only tooling that genuinely needs CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never munge these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jks binary
*.keystore binary

# Generated lockfiles: keep them in the repo, but collapse them in diffs and
# exclude them from language statistics so the repo is not reported as JSON.
package-lock.json -diff linguist-generated=true

# The edge API bundle is an esbuild build product, committed only because the
# deployed function loads it from this repository (06_deployment/README.md).
# Collapse it in pull-request diffs and keep it out of the language statistics;
# review 03_implementation/api instead.
06_deployment/api/index.js linguist-generated=true

# The phase folders that hold documents rather than source: mark them as
# documentation so the language statistics describe the code.
01_requirements/** linguist-documentation=true
02_design/** linguist-documentation=true
04_testing/** linguist-documentation=true
05_documentation/** linguist-documentation=true
